@startuml EcoShop_Final_Class_Diagram

skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam packageFontSize 14
skinparam shadowing false
skinparam roundcorner 8

title SƠ ĐỒ LỚP TỔNG THỂ HỆ THỐNG ECOSHOP (FINAL UML - TUẦN 4)
footer Nhóm EcoShop | Thành viên 1: truongtrieumen01-a11y | Thành viên 2: Kainn7

' ============================================================
' INTERFACES (Trừu tượng - Abstraction)
' ============================================================
package "Interfaces (Trừu tượng)" {
    interface Discountable {
        + {abstract} calculateDiscount(totalAmount: double): double
    }

    interface JsonSerializable {
        + {abstract} toJson(): String
    }
}

' ============================================================
' USER HIERARCHY (Kế thừa & Đa hình)
' ============================================================
package "Quản lý Người dùng (User Hierarchy)" {
    abstract class User implements JsonSerializable {
        # userId: String
        # username: String
        # password: String
        --
        + User(userId: String, username: String, password: String)
        + getUserId(): String
        + getUsername(): String
        + setUsername(username: String): void
        + setPassword(password: String): void
        + {abstract} getRole(): String
        + login(inputPassword: String): boolean
        + toString(): String
    }

    class Admin extends User {
        - adminLevel: int
        - permissions: List<String>
        --
        + Admin(userId: String, username: String, password: String, adminLevel: int)
        + getRole(): String
        + hasPermission(permission: String): boolean
        + getAdminLevel(): int
        + getPermissions(): List<String>
        + toJson(): String
        + toString(): String
    }

    abstract class Customer extends User implements Discountable {
        # address: String
        # phoneNumber: String
        # cart: ShoppingCart
        # orderHistory: List<Order>
        --
        + Customer(userId: String, username: String, password: String, address: String, phoneNumber: String)
        + {abstract} calculateDiscount(totalAmount: double): double
        + {abstract} getCustomerType(): String
        + placeOrder(): Order
        + addOrderToHistory(order: Order): void
        + getAddress(): String
        + getPhoneNumber(): String
        + getCart(): ShoppingCart
        + getOrderHistory(): List<Order>
    }

    class RegularCustomer extends Customer {
        - loyaltyPoints: int
        --
        + RegularCustomer(userId: String, username: String, password: String, address: String, phoneNumber: String)
        + calculateDiscount(totalAmount: double): double
        + getCustomerType(): String
        + getRole(): String
        + addLoyaltyPoints(points: int): void
        + earnPointsFromPurchase(amount: double): void
        + getLoyaltyPoints(): int
        + toJson(): String
        + toString(): String
    }

    class VIPCustomer extends Customer {
        - vipLevel: int
        - memberSince: LocalDate
        --
        + VIPCustomer(userId: String, username: String, password: String, address: String, phoneNumber: String, vipLevel: int)
        + calculateDiscount(totalAmount: double): double
        + getCustomerType(): String
        + getRole(): String
        + getVipLevel(): int
        + setVipLevel(level: int): void
        + getDiscountRate(): double
        + getMemberSince(): LocalDate
        + toJson(): String
        + toString(): String
    }
}

' ============================================================
' PRODUCT HIERARCHY (Kế thừa, Đa hình & Mở rộng OCP)
' ============================================================
package "Quản lý Sản phẩm Sinh thái (Product Hierarchy)" {
    abstract class Product implements JsonSerializable {
        # productId: String
        # name: String
        # description: String
        # price: double
        # stockQuantity: int
        # category: String
        --
        + Product(productId: String, name: String, description: String, price: double, stockQuantity: int, category: String)
        + {abstract} getProductType(): String
        + {abstract} getEcoBadge(): String
        + {abstract} getSpecificInfo(): String
        + isAvailable(): boolean
        + reduceStock(quantity: int): void
        + addStock(quantity: int): void
        + getProductId(): String
        + getName(): String
        + getPrice(): double
        + getStockQuantity(): int
        + getCategory(): String
        + setPrice(price: double): void
        + setStockQuantity(quantity: int): void
        + toString(): String
    }

    class ReusableProduct extends Product {
        - material: String
        - estimatedReuseCount: int
        - ecoCertificate: String
        --
        + ReusableProduct(productId: String, name: String, description: String, price: double, stockQuantity: int, category: String, material: String, estimatedReuseCount: int, ecoCertificate: String)
        + getProductType(): String
        + getEcoBadge(): String
        + getSpecificInfo(): String
        + getMaterial(): String
        + getEstimatedReuseCount(): int
        + getEcoCertificate(): String
        + toJson(): String
        + toString(): String
    }

    class OrganicProduct extends Product {
        - expiryDate: String
        - organicCertification: String
        - storageInstruction: String
        --
        + OrganicProduct(productId: String, name: String, description: String, price: double, stockQuantity: int, category: String, expiryDate: String, organicCertification: String, storageInstruction: String)
        + getProductType(): String
        + getEcoBadge(): String
        + getSpecificInfo(): String
        + getExpiryDate(): String
        + getOrganicCertification(): String
        + getStorageInstruction(): String
        + toJson(): String
        + toString(): String
    }

    class RecycledProduct extends Product {
        note top: "**[MỞ RỘNG TUẦN 4 - NGUYÊN LÝ OCP]**\nKế thừa Product mà không sửa đổi các lớp cũ"
        - recycledMaterial: String
        - recycledPercentage: int
        - recycleStandard: String
        --
        + RecycledProduct(productId: String, name: String, description: String, price: double, stockQuantity: int, category: String, recycledMaterial: String, recycledPercentage: int, recycleStandard: String)
        + getProductType(): String
        + getEcoBadge(): String
        + getSpecificInfo(): String
        + getRecycledMaterial(): String
        + getRecycledPercentage(): int
        + getRecycleStandard(): String
        + setRecycledPercentage(recycledPercentage: int): void
        + toJson(): String
        + toString(): String
    }
}

' ============================================================
' CART & ORDER (Đóng gói & Hợp thành)
' ============================================================
package "Giỏ hàng & Đơn hàng (Cart & Order)" {
    class CartItem {
        - product: Product
        - quantity: int
        --
        + CartItem(product: Product, quantity: int)
        + getSubtotal(): double
        + getProduct(): Product
        + getQuantity(): int
        + setQuantity(quantity: int): void
        + toString(): String
    }

    class ShoppingCart {
        - items: List<CartItem>
        --
        + ShoppingCart()
        + addItem(product: Product, quantity: int): void
        + removeItem(productId: String): boolean
        + updateQuantity(productId: String, newQty: int): boolean
        + getTotalAmount(): double
        + clear(): void
        + isEmpty(): boolean
        + getItems(): List<CartItem>
        + printCart(): void
    }

    enum OrderStatus {
        PENDING
        CONFIRMED
        SHIPPED
        DELIVERED
        CANCELLED
        --
        - displayName: String
        + getDisplayName(): String
        + toString(): String
    }

    class Order implements JsonSerializable {
        - orderId: String
        - customer: Customer
        - items: List<CartItem>
        - totalAmount: double
        - discountAmount: double
        - finalAmount: double
        - orderDate: LocalDateTime
        - status: OrderStatus
        - paymentMethod: String
        --
        + Order(orderId: String, customer: Customer, items: List<CartItem>)
        + Order(orderId: String, customer: Customer, items: List<CartItem>, total: double, discount: double, finalAmt: double, date: LocalDateTime, status: OrderStatus, method: String)
        + calculateFinal(): void
        + getOrderId(): String
        + getCustomer(): Customer
        + getItems(): List<CartItem>
        + getTotalAmount(): double
        + getDiscountAmount(): double
        + getFinalAmount(): double
        + getStatus(): OrderStatus
        + setStatus(status: OrderStatus): void
        + getPaymentMethod(): String
        + setPaymentMethod(method: String): void
        + toJson(): String
        + toString(): String
    }

    class PaymentProcessor {
        - paymentMethod: String
        --
        + PaymentProcessor()
        + processPayment(order: Order, method: String, scanner: Scanner): void
        + generateReceipt(order: Order): String
    }
}

' ============================================================
' SERVICE & APP
' ============================================================
package "Dịch vụ & Điều khiển (Service & App)" {
    class JsonDataManager {
        - usersFile: String
        - productsFile: String
        - ordersFile: String
        --
        + JsonDataManager(dataDirectory: String)
        + saveUsers(users: List<User>): void
        + loadUsers(): List<User>
        + saveProducts(products: List<Product>): void
        + loadProducts(): List<Product>
        + saveOrders(orders: List<Order>): void
        + loadOrders(users: List<User>, products: List<Product>): List<Order>
    }

    class EcoShopApp {
        - dataManager: JsonDataManager
        - paymentProcessor: PaymentProcessor
        - scanner: Scanner
        - users: List<User>
        - products: List<Product>
        - orders: List<Order>
        - currentUser: User
        --
        + EcoShopApp()
        + {static} main(args: String[]): void
        + run(): void
    }
}

' ============================================================
' EXCEPTIONS
' ============================================================
package "Hệ thống Ngoại lệ (Exceptions)" {
    class EcoShopException extends Exception {
        - errorCode: String
        --
        + EcoShopException(message: String, errorCode: String)
        + getErrorCode(): String
    }

    class InsufficientStockException extends EcoShopException {
        - availableStock: int
        --
        + InsufficientStockException(requested: int, available: int)
        + getAvailableStock(): int
    }

    class ProductNotFoundException extends EcoShopException {
        + ProductNotFoundException(productId: String)
    }

    class PaymentFailedException extends EcoShopException {
        + PaymentFailedException(reason: String)
    }

    class InvalidInputException extends EcoShopException {
        + InvalidInputException(field: String)
    }
}

' ============================================================
' RELATIONSHIPS (Quan hệ OOP)
' ============================================================
User <|-- Admin
User <|-- Customer
Customer <|-- RegularCustomer
Customer <|-- VIPCustomer

Product <|-- ReusableProduct
Product <|-- OrganicProduct
Product <|-- RecycledProduct : "<<mở rộng OCP>>"

Customer "1" *-- "1" ShoppingCart : sở hữu
Customer "1" o-- "*" Order : lịch sử mua
ShoppingCart "1" *-- "*" CartItem : chứa
CartItem "1" --> "1" Product : tham chiếu

Order "1" --> "1" Customer : thuộc về
Order "1" *-- "*" CartItem : gồm các món
Order "1" --> "1" OrderStatus : trạng thái

PaymentProcessor ..> Order : xử lý thanh toán & trừ kho
EcoShopApp --> JsonDataManager : lưu trữ dữ liệu
EcoShopApp --> PaymentProcessor : điều khiển thanh toán
EcoShopApp --> User : quản lý phiên
EcoShopApp --> Product : quản lý kho

ShoppingCart ..> InsufficientStockException : ném ngoại lệ
PaymentProcessor ..> PaymentFailedException : ném ngoại lệ

@enduml
